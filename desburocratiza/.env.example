# Copie este arquivo para .env e preencha os valores.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=troque-por-um-segredo-aleatorio-com-no-minimo-32-caracteres

# SMTP para enviar o link de verificação de e-mail
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Desburocratiza <nao-responda@seudominio.com>"

# Opcional: chave da API OpenAI. Nunca coloque esta chave no frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
